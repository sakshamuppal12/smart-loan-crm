# Copy this file to ".env" and fill in your own values.
# Never commit your real ".env" file to GitHub.

# Any random long string works for local dev. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-key

# Leave as-is for local SQLite dev, or paste your own Supabase/Postgres URL for production.
# Example Postgres URL: postgresql://username:password@host:5432/dbname
DATABASE_URL=sqlite:///site.db
